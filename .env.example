# Copy to .env.local and fill in (never commit .env.local)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
# Project Settings -> API Keys: use the publishable key (sb_publishable_...) on
# new projects, or the legacy anon key (JWT) on older ones. Newer projects
# reject legacy keys on Edge Function calls.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
