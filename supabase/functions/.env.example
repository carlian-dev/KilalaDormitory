# Copy to supabase/functions/.env.local (git-ignored via the *.local rule)
# and fill in your own free Gemini API key. Used only for LOCAL testing:
#   supabase functions serve dormi-chat --env-file supabase/functions/.env.local
#
# Production values are Supabase secrets, never files:
#   supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=your-free-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
DORMI_USER_DAILY_LIMIT=20
DORMI_GLOBAL_DAILY_LIMIT=200
